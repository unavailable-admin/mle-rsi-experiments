# Export these in your shell; the application does not auto-load .env files.
RSI_EVAL_WORKSPACE=/path/to/mle-workspace
RSI_GEMINI_API_KEY=replace-in-your-shell
# Optional: use an existing Python 3.12 environment instead of .venv.
# MLE_RSI_PYTHON=/path/to/python

# GPT experiments use this variable; export an actual key in your shell.
# RSI_GPT_API_KEY=replace-in-your-shell
