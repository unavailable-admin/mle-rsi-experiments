#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
runner="${MLE_RSI_PYTHON:-}"
if [[ -z "$runner" ]]; then
  if [[ -x "$PWD/.venv/bin/python" ]]; then
    runner="$PWD/.venv/bin/python"
  elif [[ -x /mnt/afs/yangsen1/envs/dream-rsi-mle/bin/python ]]; then
    runner=/mnt/afs/yangsen1/envs/dream-rsi-mle/bin/python
  else
    runner=python3
  fi
fi
# Pin before Python imports can create BLAS threads; export runs on the source host.
if [[ "${1:-}" == "export" ]]; then
  exec "$runner" -m mle_rsi.offline_max "$@"
fi
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
exec taskset -c 0-31 "$runner" -m mle_rsi.offline_max "$@"
