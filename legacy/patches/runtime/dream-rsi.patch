 class ResponseError(RSIError):
     pass
+
+
+class PolicyTimeout(PolicyError):
+    """Local worker deadline expired; safe to replay without external calls."""
+
+
+def legacy_replay_timeout(value):
+    """Recognize only the old empty TimeoutError message, never malformed JSON."""
+    if value is None or getattr(value, 'status', None) != 'invalid':
+        return False
+    rows = getattr(value, 'worlds', None)
+    if rows is not None:
+        failed = [r for r in rows if r.status == 'invalid']
+        return bool(failed) and all(legacy_replay_timeout(r) for r in failed)
+    return getattr(value, 'error', None) == 'Policy timeout or malformed output: '
