+                raise InfrastructureError("Offline refresh requires an exact completed boundary")
+            state = self.store.get("offline_refresh_state", key)
+            if state is None:
+                state = {k:v for k,v in cp.items() if k not in ("pool_hash", "selected_id", "selected_mean_V")}
+                state["phase"] = "HISTORY_FROZEN"
+                state["pool_hash"] = self._pool(state).pool_hash
