+"""Host-enforced, state-dependent bounded repairs shared by online and replay policy workers."""
 from dataclasses import replace
 
 from .tree import BatchValidator
 
 
+def repair_parent_ids(nodes, eligible, slots):
+    """One child per failed node, no failed-debug chains; ordinary slot budget."""
+    used = {n['parent_id'] for n in nodes if n['parent_id'] is not None}
+    failures = [n for n in nodes if n['node_id'] in eligible
+                and n['parent_id'] is not None and not n['valid']
+                and n.get('stage') != 'debug' and n['node_id'] not in used
+                and n['fail_class'] in ('runtime_error', 'timeout', 'source_error', 'output_contract_error')]
+    successes = any(n['valid'] and n['fail_class'] == 'ok' and n['parent_id'] is not None for n in nodes)
+    limit = min(slots, 1 if successes or slots < 3 else min(3, (slots + 1) // 2))
+    # Stable across dictionary ordering; newest first within each error category.
+    failures.sort(key=lambda n: (n.get('created_order', 0), n['node_id']), reverse=True)
+    chosen = []
+    categories = set()
+    for n in failures:
+        if n['fail_class'] not in categories:
+            chosen.append(n['node_id'])
+            categories.add(n['fail_class'])
+    chosen += [n['node_id'] for n in failures if n['node_id'] not in chosen]
+    return chosen[:limit]
+
